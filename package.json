{
  "name": "delay-repay-checker",
  "version": "0.0.0",
  "private": true,
  "description": "Scans a UK rail commute against HSP historical performance data and flags journeys that look claimable under Delay Repay.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
