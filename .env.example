# National Rail Data Portal credentials, with the HSP subscription box ticked.
# Register at https://opendata.nationalrail.co.uk/ then subscribe to
# "Historical Service Performance".
#
# Copy this file to .env and fill in. Never commit .env.
HSP_EMAIL=
HSP_PASSWORD=

# Optional. Defaults to the production HSP endpoint.
# HSP_BASE_URL=https://hsp-prod.rockshore.net/api/v1

# Optional. Directory for the route+date response cache.
# HSP_CACHE_DIR=.cache/hsp
